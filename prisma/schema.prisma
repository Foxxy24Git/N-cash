generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  fullName  String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
}

model CompanyProfile {
  id      String  @id @default(cuid())
  name    String
  address String
  phone   String?
  logoUrl String?
}

model Bank {
  id            String        @id @default(cuid())
  name          String
  accountNumber String?
  accountHolder String?
  createdAt     DateTime      @default(now())
  invoices      Invoice[]
  paidInvoices  Invoice[]     @relation("PaidBank")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  date          DateTime
  totalAmount   Decimal
  paymentMethod String
  bankId        String?
  bank          Bank?         @relation(fields: [bankId], references: [id])
  items         InvoiceItem[]
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  paidAt        DateTime?
  paidMethod    String?
  paidBankId    String?
  paidBank      Bank?         @relation("PaidBank", fields: [paidBankId], references: [id])
  paymentLogs   PaymentLog[]
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
}

model InvoiceItem {
  id               String   @id @default(cuid())
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id])
  itemName         String
  quantity         Decimal
  unitPrice        Decimal
  buyPriceSnapshot Decimal?
  subtotal         Decimal
}

// ─── STOK ───────────────────────────────────────────────────────────────────

model Product {
  id           String   @id @default(cuid())
  name         String
  unit         String
  buyPrice     Decimal
  sellingPrice Decimal
  stock        Int      @default(0)
  minStock     Int      @default(0)
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]
  adjustments    StockAdjustment[]

  @@index([name])
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  type        String
  quantity    Int
  stockBefore Int
  stockAfter  Int
  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())
}

model StockAdjustment {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  oldStock  Int
  newStock  Int
  reason    String
  notes     String?
  createdAt DateTime @default(now())
}

model PaymentLog {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paidAt     DateTime @default(now())
  paidMethod String
  paidBankId String?
  amount     Decimal
  notes      String?
  createdAt  DateTime @default(now())
}
