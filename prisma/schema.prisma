generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model CompanyProfile {
  id      String  @id @default(cuid())
  name    String
  address String
  phone   String?
  logoUrl String?
}

model Bank {
  id            String        @id @default(cuid())
  name          String
  accountNumber String?
  accountHolder String?
  createdAt     DateTime      @default(now())
  invoices      Invoice[]
  paidInvoices  Invoice[]     @relation("PaidBank")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  date          DateTime
  totalAmount   Decimal
  paymentMethod String
  bankId        String?
  bank          Bank?         @relation(fields: [bankId], references: [id])
  items         InvoiceItem[]
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  paidAt        DateTime?
  paidMethod    String?
  paidBankId    String?
  paidBank      Bank?         @relation("PaidBank", fields: [paidBankId], references: [id])
  paymentLogs   PaymentLog[]
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemName  String
  quantity  Decimal
  unitPrice Decimal
  subtotal  Decimal
}

model PaymentLog {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paidAt     DateTime @default(now())
  paidMethod String
  paidBankId String?
  amount     Decimal
  notes      String?
  createdAt  DateTime @default(now())
}
